# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/local/bizia.json

# --- Intelligence Artificielle (Gemini Pro / Groq) ---
# LLM_PROVIDER: "auto", "gemini", "groq" ou "none"
LLM_PROVIDER=gemini

# Google Gemini (Abonnement Pro / Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENRICH_ANALYSIS=true

# Groq (Llama 3.3 70B & Whisper transcription)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Supabase V2 (Optionnel - fallback store JSON si vide) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seuil d'alerte stock
DEFAULT_LOW_STOCK_THRESHOLD=5
